{
  "name": "icejazz-player",
  "private": true,
  "version": "1.5.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "jazz": "node scripts/run-jazz.mjs",
    "jazz:web": "vite --port=3000 --host=0.0.0.0",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "dist:win": "vite build && npx electron-builder --win nsis portable",
    "dist:installer": "vite build && npx electron-builder --win nsis",
    "dist:portable": "vite build && npx electron-builder --win portable",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.icejazz.audioplayer",
    "productName": "IceJaZz",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IceJaZz",
      "uninstallDisplayName": "IceJaZz Audio Player",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "IceJaZz-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
